# ===== LLM（必选，OpenAI 兼容接口）=====
# 任何 OpenAI 兼容服务商都可以：DeepSeek / 智谱 / 通义 / OpenAI 官方等
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key-here
# 主模型：预筛、打分、写作、聚簇与融合裁决
LLM_MODEL=deepseek-chat
# 第二评分模型（可选）：与主模型独立打分提高一致性；不配则用主模型换温度再评
LLM_MODEL_B=
# 向量模型（可选）：配置后聚簇候选用语义向量召回；不配则退化为词面相似度
LLM_EMBED_MODEL=
# 向量端点与 Key（可选）：留空时复用上面的 LLM_BASE_URL / LLM_API_KEY。
# 混搭服务商时显式指定。Key 支持 ${VAR} 引用环境变量（.env 不落密钥字面量）：
#   LLM_API_KEY=${MY_LLM_KEY}
# 向量接口风格 LLM_EMBED_STYLE：openai（默认，标准 /embeddings 批量）
# 或 ark-multimodal（火山方舟 doubao-embedding-vision 系列，/embeddings/multimodal 单条）
LLM_EMBED_BASE_URL=
LLM_EMBED_API_KEY=
# 向量输出维度（可选，MRL 可调表示）：0 = 服务商默认。
# Qwen3-Embedding-8B 最大 4096；OpenAI text-embedding-3-* 最大 3072；
# 方舟 ark-multimodal 风格固定维度，忽略本项
LLM_EMBED_DIMENSIONS=0
LLM_EMBED_STYLE=
# 关闭深度思考（可选）：方舟 doubao-seed 等推理模型的结构化判定任务提速约 5 倍
LLM_THINKING=
# 预算熔断（可选）：每日 Token 上限，超限自动停止精选/聚簇等 LLM 阶段（0=不熔断）
LLM_BUDGET_TOKENS_PER_DAY=0
# 单价（可选）：每百万 token 价格，仅用于控制台成本估算展示
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0

# ===== 通知推送（可选）=====
# 日报生成后与流水线失败时推送到 webhook；支持 raw / feishu / wecom 三种格式
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_FORMAT=

# ===== 管理鉴权（可选，推荐配置）=====
# 密码登录模式（推荐）：用 `githubhot admin hash 你的密码` 生成，粘到下面。
# 登录后下发 HttpOnly 会话 Cookie（12h 有效，"记住我" 7 天），密码不明文存储。
ADMIN_PASSWORD_HASH=
# 旧版令牌模式（兼容）：设置后请求需带 X-Admin-Token 头；与上方同时配置时密码模式优先
ADMIN_TOKEN=

# ===== GitHub（可选，强烈建议配置）=====
# 未配置时限额 60 次/小时；配置后 5000 次/小时
# https://github.com/settings/tokens 生成（公开仓库只读，无需勾选任何权限）
GITHUB_TOKEN=
# 国内服务器直连 github.com 失败时：镜像前缀（拼接在原始地址前）
# 例：GITHUB_PROXY=https://gh-proxy.com
# 也可改用系统代理：HTTPS_PROXY=http://127.0.0.1:7890（采集与 LLM 请求均遵循）
GITHUB_PROXY=

# ===== 运行 =====
# 数据目录：SQLite、日报 Markdown、生成的三榜站点
DATA_DIR=./data
# serve 模式端口
PORT=8787
# serve 模式内置调度（cron 表达式，本地时区；默认每天 07:30）
HOT_CRON=30 7 * * *
# 音乐馆（/music）默认歌单 id（可选）；歌单经 /api/v1/music/playlist 代理加载
MUSIC_PLAYLIST=
# 允许跨域的来源（逗号分隔，给 Web 前端/APP 内嵌页用；默认不开放）
CORS_ORIGINS=

# ===== IP 防护 / 三层身份识别 =====
# IP_GUARD_ENABLED=0 可整体关闭（默认开启）
# IP_GUARD_LOCAL=0 关闭回环/内网白名单——公网部署务必关闭，让防护对全部访客生效；
# 本地开发保持默认（1），否则测试请求会把自己封掉
# IP_GUARD_SECRET 身份令牌 HMAC 密钥（不设置则每次启动随机生成，重启后旧令牌失效）
IP_GUARD_ENABLED=
IP_GUARD_LOCAL=
IP_GUARD_SECRET=
