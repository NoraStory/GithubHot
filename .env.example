# ===== LLM（必选，OpenAI 兼容接口）=====
# 任何 OpenAI 兼容服务商都可以：DeepSeek / 智谱 / 通义 / OpenAI 官方等
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key-here
# 主模型：预筛、打分、写作、聚簇与融合裁决
LLM_MODEL=deepseek-chat
# 第二评分模型（可选）：与主模型独立打分提高一致性；不配则用主模型换温度再评
LLM_MODEL_B=
# 向量模型（可选）：配置后聚簇候选用语义向量召回；不配则退化为词面相似度
LLM_EMBED_MODEL=
# 向量端点与 Key（可选）：留空时复用上面的 LLM_BASE_URL / LLM_API_KEY。
# 混搭服务商时显式指定。Key 支持 ${VAR} 引用环境变量（.env 不落密钥字面量）：
#   LLM_API_KEY=${MY_LLM_KEY}
# 向量接口风格 LLM_EMBED_STYLE：openai（默认，标准 /embeddings 批量）
# 或 ark-multimodal（火山方舟 doubao-embedding-vision 系列，/embeddings/multimodal 单条）
LLM_EMBED_BASE_URL=
LLM_EMBED_API_KEY=
# 向量输出维度（可选，MRL 可调表示）：0 = 服务商默认。
# Qwen3-Embedding-8B 最大 4096；OpenAI text-embedding-3-* 最大 3072；
# 方舟 ark-multimodal 风格固定维度，忽略本项
LLM_EMBED_DIMENSIONS=0
LLM_EMBED_STYLE=
# 关闭深度思考（可选）：方舟 doubao-seed 等推理模型的结构化判定任务提速约 5 倍
LLM_THINKING=
# 预算熔断（可选）：每日 Token 上限，超限自动停止精选/聚簇等 LLM 阶段（0=不熔断）
LLM_BUDGET_TOKENS_PER_DAY=0
# 单价（可选）：每百万 token 价格，仅用于控制台成本估算展示
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0

# ===== 通知推送（可选）=====
# 日报生成后与流水线失败时推送到 webhook；支持 raw / feishu / wecom 三种格式
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_FORMAT=

# ===== 管理鉴权（可选，推荐配置）=====
# 密码登录模式（推荐）：用 `githubhot admin hash 你的密码` 生成，粘到下面。
# 登录后下发 HttpOnly 会话 Cookie（12h 有效，"记住我" 7 天），密码不明文存储。
ADMIN_PASSWORD_HASH=
# 旧版令牌模式（兼容）：设置后请求需带 X-Admin-Token 头；与上方同时配置时密码模式优先
ADMIN_TOKEN=

# ===== GitHub（可选，强烈建议配置）=====
# 未配置时限额 60 次/小时；配置后 5000 次/小时
# https://github.com/settings/tokens 生成（公开仓库只读，无需勾选任何权限）
GITHUB_TOKEN=
# 国内服务器直连 github.com 失败时：镜像前缀（拼接在原始地址前）
# 例：GITHUB_PROXY=https://gh-proxy.com
# 也可改用系统代理：HTTPS_PROXY=http://127.0.0.1:7890（采集与 LLM 请求均遵循）
GITHUB_PROXY=

# ===== 运行 =====
# 数据目录：SQLite、日报 Markdown、生成的三榜站点
DATA_DIR=./data
# serve 模式端口
PORT=8787
# serve 模式内置调度（cron 表达式，本地时区；默认每天 07:30）
HOT_CRON=30 7 * * *
# 音乐馆（/music）默认歌单 id（可选）；歌单经 /api/v1/music/playlist 代理加载
MUSIC_PLAYLIST=
# 允许跨域的来源（逗号分隔，给 Web 前端/APP 内嵌页用；默认不开放）
CORS_ORIGINS=

# ===== IP 防护 / 三层身份识别 =====
# IP_GUARD_ENABLED=0 可整体关闭（默认开启）
# IP_GUARD_LOCAL=0 关闭回环/内网白名单——公网部署务必关闭，让防护对全部访客生效；
# 本地开发保持默认（1），否则测试请求会把自己封掉
# IP_GUARD_SECRET 身份令牌 HMAC 密钥（不设置则每次启动随机生成，重启后旧令牌失效）
#   令牌签名失效现在只记 15 分并自动重签，不再按"伪造"即时封禁；
#   但生产仍必须显式配置，否则每次重启都会给全部老访客重签一次令牌。
# TRUSTED_PROXY 受信反向代理（CIDR，逗号分隔）。为空 = 不信任任何代理头，一律用 TCP
#   对端地址；只有直连方在名单内才采信 X-Forwarded-For / X-Real-IP，并取最右非受信地址。
#   直连部署留空（否则攻击者可自填 XFF 栽赃他人 IP）。
#   TRUSTED_PROXY=127.0.0.1/32              # 本机 nginx / caddy
#   TRUSTED_PROXY=127.0.0.1/32,10.0.0.0/8   # 多级内网代理
IP_GUARD_ENABLED=
IP_GUARD_LOCAL=
IP_GUARD_SECRET=
TRUSTED_PROXY=
# ---------- APP 请求签名（Android 客户端） ----------
# APP_SIGN_SEED APP 接口签名种子（32 字节 base64，`githubhot admin seed` 生成）。
#   serve 模式强制：未配置或仍是出厂默认 gh-dev-seed-v1 时拒绝启动——该值历史版本
#   随 /api/v1/site/config 公开下发，等于派生密钥公开可复现。
#   种子只经环境变量共享：服务端读这里，APP 侧在构建期注入同名值（Gradle buildConfigField）。
# APP_SIGN_SEED_GRACE 过渡期旧种子（逗号分隔，仅参与验签，不下发）。
#   存量 APP 仍在用握手期缓存的旧种子；过渡期内"无常用种子验签通过"只观察不计分，
#   避免正常用户被连续 401 攒积分封禁。APP 发版完成后应清空（建议 ≤14 天）。
#   APP_SIGN_SEED_GRACE=gh-dev-seed-v1
APP_SIGN_SEED=
APP_SIGN_SEED_GRACE=# HANDSHAKE_RATE_PER_MIN 握手通道（/api/v1/site/config）单 IP 每分钟上限，默认 30。
#   该端点免签（APP 冷启动要从这里拿远程封禁/强制更新策略）且会触发指纹归档写库，
#   超限返回 429 并记 handshake-rate 弱证据（单条不封，可与其它的证据互证）
HANDSHAKE_RATE_PER_MIN=# FP_SCORE_SHADOW 新增检测 flag 的灰度开关，默认 1 = 只记录不计分。
#   P1 检测族（fpb_*/botd_*）先只记录，在管理端"检测命中统计"观察命中与假阳性率；
#   连续 7 天假阳性 < 0.5% 后再置 0，让 fpb_canvas_diverge / fpb_iframe_diverge /
#   fpb_audio_diverge / fpb_gpu_claim_mismatch / fpb_native_fn_tamper 各计 15 分。
FP_SCORE_SHADOW=

# ---- P2 算法升级（GeoIP 交叉核验 / 熵值加权） ----
# GEOIP_DB_PATH 国家库（sapics/ip-location-db，CC BY 4.0；githubhot geo download 拉取）。
#   文件缺失时全部地理核验自动降级跳过（不报错）。下载后部署说明需保留数据致谢。
# GEOIP_DB_PATH=data/geo.mmdb
GEOIP_DB_PATH=
# GEOIP_ASN_DB_PATH ASN 库（dbip-asn-lite.mmdb），用于机房出口（hosting）识别。
GEOIP_ASN_DB_PATH=
# ENTROPY_CRON 分量熵权每日刷新调度（robfig cron 五段式，本地时区），默认每天 04:30。
#   熵权 bits = Σ -log2(c(v)/N)；三层违规分 × min(1, bits/40) 作为封禁触发系数。
ENTROPY_CRON=

# ---- P3 TLS + JA4 ----
# TLS_CERT/TLS_KEY 证书与私钥路径（同时配置 → TLS 模式：HSTS + Secure cookie + JA4 捕获）。
# 与 ACME_DOMAIN 二选一；两者都无 → 纯 HTTP（本地开发模式，JA4 核验自动关闭）。
# TLS_CERT=
# TLS_KEY=
# ACME_DOMAIN 自动签发域名（逗号分隔，需公网可达 80/443；证书缓存 data/acme）。
# ACME_DOMAIN=
# REDIRECT_HTTP=1 监听 80 端口做 301 跳 HTTPS（ACME 模式下必须监听，无需此开关）。
REDIRECT_HTTP=

# ---- P4 平台证明与请求成本 ----
# ALTCHA 工作量证明（P4-3）：ALTCHA_SECRET 配置后挑战端点可用；ALTCHA_DIFFICULTY>0（推荐 12）
# 时 fp/report 强制携带有效 PoW（裸请求 401+计分）。灰度建议：先发前端（altcha.js 自动求解）
# 再置 12。ALTCHA_MAXAGE_SEC 挑战有效期，默认 600。
ALTCHA_SECRET=
ALTCHA_DIFFICULTY=
# ALTCHA_MAXAGE_SEC=600
# Play Integrity（P4-1）：PLAY_INTEGRITY_PACKAGE 为 APP 包名；PLAY_INTEGRITY_SA_JSON 指向
# GCP service account JSON（scope playintegrity）。两者齐备走 Google 主路径；缺失时
# /app/attest/verify 自动支持降级路径（APP 上报签名证书 SHA-256 + ThreatDetect）。
# APP_EXPECTED_CERT_SHA256 期望的 APK 签名证书指纹（逗号分隔，两种路径都校验）。
# ATTEST_REQUIRED=1 时无效设备进入只读降级模式（响应携带标志，APP 侧行为）。
PLAY_INTEGRITY_PACKAGE=
PLAY_INTEGRITY_SA_JSON=
APP_EXPECTED_CERT_SHA256=
ATTEST_REQUIRED=
