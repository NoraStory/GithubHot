# ===== LLM（必选，OpenAI 兼容接口）=====
# 任何 OpenAI 兼容服务商都可以：DeepSeek / 智谱 / 通义 / OpenAI 官方等
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key-here
# 主模型：预筛、打分、写作、聚簇与融合裁决
LLM_MODEL=deepseek-chat
# 第二评分模型（可选）：与主模型独立打分提高一致性；不配则用主模型换温度再评
LLM_MODEL_B=
# 向量模型（可选）：配置后聚簇候选用语义向量召回；不配则退化为词面相似度
LLM_EMBED_MODEL=

# ===== GitHub（可选，强烈建议配置）=====
# 未配置时限额 60 次/小时；配置后 5000 次/小时
# https://github.com/settings/tokens 生成（公开仓库只读，无需勾选任何权限）
GITHUB_TOKEN=

# ===== 运行 =====
# 数据目录：SQLite、日报 Markdown、生成的双榜站点
DATA_DIR=./data
# serve 模式端口
PORT=8787
# serve 模式内置调度（cron 表达式，本地时区；默认每天 07:30）
HOT_CRON=30 7 * * *
# 允许跨域的来源（逗号分隔，给 Web 前端/APP 内嵌页用；默认不开放）
CORS_ORIGINS=
